# Local secrets for Alpha Pod
# Copy this file to `.env` and fill in only what you use.

# OpenAI-compatible LLM provider
OPENAI_API_KEY=
OPENAI_BASE_URL=

# Optional OpenRouter override. Leave the model blank to use config/config.yaml.
OPENROUTER_API_KEY=
OPENROUTER_FREE_MODEL=

# Gemini OpenAI-compatible path
GEMINI_API_KEY=
GOOGLE_API_KEY=

# Optional research / macro providers
PERPLEXITY_API_KEY=
FRED_API_KEY=

# Optional runtime overrides
# Leave model fields blank to use the role-based block in config/config.yaml.
LLM_MODEL=
LLM_MODEL_FAST=
LLM_SYNTHESIS_MODEL=
ALPHA_POD_AGENT_BACKEND=
ALPHA_POD_LLM_PROVIDER=
ALPHA_POD_JUDGMENT_BACKEND=
ALPHA_POD_JUDGMENT_PRIMARY_MODEL=
# Legacy Gemini Search grounding adapter only; regular IndustryAgent routing uses the judgment role.
INDUSTRY_AGENT_MODEL=gemini-3-flash-preview
# For an explicit OpenRouter override, set LLM_BASE_URL=https://openrouter.ai/api/v1.
LLM_BASE_URL=
EDGAR_USER_AGENT=AI-Fund research@example.com
EDGAR_LOCAL_DATA_DIR=data/cache/edgar_tools
ALPHA_POD_EDGAR_CACHE_ONLY=0
ALPHA_POD_MARKET_CACHE_ONLY=0
ALPHA_POD_ALLOW_STALE_MARKET_CACHE=0
ALPHA_POD_DB_PATH=
